# Dependency policy. Guardrail check [12] fails if any of these is removed or weakened, and the
# agent's command guard blocks overriding them with a flag or an environment variable. Change them
# in a reviewed pull request, never for one command. Needs npm 11.10 or later (Node 24 ships it).

# Install only versions released at least 7 days ago. Hijacked releases are usually caught and
# pulled within days, and a package name an assistant invented is almost always brand new. To take
# an urgent fix sooner, add the package to min-release-age-exclude in a reviewed change.
min-release-age=7

# Dependencies come from the registry only: no git repositories, no tarball URLs.
allow-git=none
allow-remote=none

# A dependency's install script runs only if it is approved in package.json (`npm approve-scripts
# <pkg>`). An unreviewed one fails the install instead of being skipped with a warning.
strict-allow-scripts=true
